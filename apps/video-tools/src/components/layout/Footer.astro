---
import Container from "@repo/ui/Container.astro";
import { siblingLoomfileTools } from "@repo/seo/loomfileNetwork";
import { OPERATION_PAGES } from "@/data/operationPages";
import { OPERATIONS } from "@/data/operations";
import { FORMATS } from "@/data/formats";
import { SITE } from "@/data/site";
import { withBase } from "@repo/file-tools-core/url.ts";

const moreTools = siblingLoomfileTools("/video/");
---

<footer class="mt-16 border-t border-neutral-200 bg-neutral-50">
  <Container class="grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="text-base font-bold text-neutral-900">{SITE.name}</p>
      <p class="mt-2 text-sm text-neutral-600">{SITE.tagline}</p>
    </div>

    <div>
      <p class="text-sm font-semibold text-neutral-900">Tools</p>
      <ul class="mt-3 space-y-2 text-sm text-neutral-600">
        {
          OPERATION_PAGES.map((page) => (
            <li>
              <a href={withBase(page.slug)} class="hover:text-accent-600">
                {OPERATIONS[page.operation].verb} {FORMATS[page.format].label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold text-neutral-900">Company</p>
      <ul class="mt-3 space-y-2 text-sm text-neutral-600">
        <li><a href={withBase("/about")} class="hover:text-accent-600">About</a></li>
        <li><a href={withBase("/faq")} class="hover:text-accent-600">FAQ</a></li>
        <li><a href={withBase("/how-it-works")} class="hover:text-accent-600">How it works</a></li>
        <li><a href={withBase("/contact")} class="hover:text-accent-600">Contact</a></li>
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold text-neutral-900">Legal</p>
      <ul class="mt-3 space-y-2 text-sm text-neutral-600">
        <li><a href={withBase("/privacy-policy")} class="hover:text-accent-600">Privacy Policy</a></li>
        <li><a href={withBase("/terms-of-service")} class="hover:text-accent-600">Terms of Service</a></li>
      </ul>
    </div>
  </Container>

  <div class="border-t border-neutral-200 py-8">
    <Container>
      <p class="text-sm font-semibold text-neutral-900">More free tools on LoomFile</p>
      <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-sm text-neutral-600">
        {
          moreTools.map((tool) => (
            <li>
              <a href={tool.url} class="hover:text-accent-600">
                {tool.name}
              </a>
            </li>
          ))
        }
      </ul>
    </Container>
  </div>

  <div class="border-t border-neutral-200 py-6">
    <Container>
      <p class="text-xs text-neutral-500">
        © {new Date().getFullYear()} {SITE.name}. Every tool runs locally in your browser — your videos are never uploaded.
      </p>
    </Container>
  </div>
</footer>
