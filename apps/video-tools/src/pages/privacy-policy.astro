---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@repo/ui/Container.astro";
import { SITE } from "@/data/site";
import { withBase } from "@repo/file-tools-core/url.ts";

const lastUpdated = "September 4, 2026";
---

<BaseLayout
  title={`Privacy Policy | ${SITE.name}`}
  description={`How ${SITE.name} handles your data. In short: your video never leaves your browser.`}
  path="/privacy-policy"
>
  <Container>
    <article class="mx-auto max-w-2xl py-14">
      <h1 class="text-3xl font-extrabold text-neutral-900">Privacy Policy</h1>
      <p class="mt-2 text-sm text-neutral-500">Last updated: {lastUpdated}</p>

      <div class="mt-6 space-y-5 text-base leading-relaxed text-neutral-700">
        <h2 class="text-xl font-bold text-neutral-900">Your video</h2>
        <p>
          {SITE.name} compresses and trims video entirely within your browser using your browser's built-in
          WebCodecs API, orchestrated by an open-source JavaScript library called <strong>mediabunny</strong>. This
          library does not transmit your file contents anywhere. Whether you're compressing a video or trimming it
          to a time range, every step — reading the file, decoding it, re-encoding it, and building the result — runs
          locally on your device.
        </p>
        <p>
          Heavy processing runs inside a background script (a Web Worker) so the page stays responsive. This script
          is served from our own site, not a third party, and never sends your file data anywhere. Your videos are
          never transmitted to, stored on, or processed by any server we operate — we have no ability to see,
          access, or retain any file you process on this site. See
          <a href={withBase("/how-it-works")} class="text-accent-600 underline">How it works</a> for more detail,
          including how to verify this yourself using your browser's developer tools.
        </p>

        <h2 class="text-xl font-bold text-neutral-900">Analytics</h2>
        <p>
          We may use privacy-respecting analytics to understand aggregate traffic patterns (e.g. which pages are
          visited, approximate country of origin). This data is anonymized/aggregated and is not linked to any file
          you process on this site.
        </p>

        <h2 class="text-xl font-bold text-neutral-900">Advertising</h2>
        <p>
          This site may display advertising served by Google AdSense. Google and its partners may use cookies or
          similar technologies to serve ads based on your prior visits to this or other websites. You can opt out of
          personalized advertising by visiting Google's
          <a href="https://adssettings.google.com" class="text-accent-600 underline" rel="noopener noreferrer" target="_blank">
            Ads Settings
          </a>. For more information on how Google uses data, see
          <a
            href="https://policies.google.com/technologies/partner-sites"
            class="text-accent-600 underline"
            rel="noopener noreferrer"
            target="_blank"
          >
            How Google uses information from sites that use its services
          </a>.
        </p>

        <h2 class="text-xl font-bold text-neutral-900">Cookies</h2>
        <p>
          This site itself does not set cookies for its video tools to function. Third-party services we use
          (analytics, advertising, once enabled) may set their own cookies, governed by their own privacy policies.
        </p>

        <h2 class="text-xl font-bold text-neutral-900">Your rights</h2>
        <p>
          Depending on your location, you may have rights under regulations such as the GDPR or CCPA to access,
          correct, or delete personal data we hold about you. Since we do not collect personal data tied to the
          videos you process, there is generally nothing of that nature to request. For questions, see our
          <a href={withBase("/contact")} class="text-accent-600 underline">Contact page</a>.
        </p>

        <h2 class="text-xl font-bold text-neutral-900">Changes to this policy</h2>
        <p>We may update this policy from time to time. Changes will be posted on this page with an updated revision date.</p>
      </div>
    </article>
  </Container>
</BaseLayout>
