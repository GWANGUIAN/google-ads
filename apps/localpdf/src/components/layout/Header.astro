---
import Container from "@repo/ui/Container.astro";
import { SITE } from "@/data/site";
import { withBase } from "@repo/file-tools-core/url.ts";
---

<header class="border-b border-neutral-200 bg-white/80 backdrop-blur">
  <Container class="flex h-16 items-center justify-between">
    <a href={withBase("/")} class="flex items-center gap-2 text-base font-bold text-neutral-900">
      <span class="flex h-8 w-8 items-center justify-center rounded-control bg-accent-600 text-white">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 3h9l5 5v13a1 1 0 01-1 1H6a1 1 0 01-1-1V4a1 1 0 011-1Z" stroke-linejoin="round" />
          <path d="M15 3v5h5" stroke-linejoin="round" />
        </svg>
      </span>
      {SITE.name}
    </a>
    <nav class="hidden items-center gap-5 text-sm font-medium text-neutral-600 lg:flex">
      <a href={withBase("/jpg-to-pdf")} class="hover:text-neutral-900">JPG to PDF</a>
      <a href={withBase("/merge-pdf")} class="hover:text-neutral-900">Merge</a>
      <a href={withBase("/split-pdf")} class="hover:text-neutral-900">Split</a>
      <a href={withBase("/reorder-pdf-pages")} class="hover:text-neutral-900">Organize</a>
      <a href={withBase("/pdf-viewer")} class="hover:text-neutral-900">Viewer</a>
      <a href={withBase("/extract-text-from-pdf")} class="hover:text-neutral-900">Extract</a>
    </nav>
  </Container>
</header>
