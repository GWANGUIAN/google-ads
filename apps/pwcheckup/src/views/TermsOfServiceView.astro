---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@repo/ui/Container.astro";
import StaticPageBody from "@/components/pages/StaticPageBody.astro";
import { getDictionary, type Locale } from "@/i18n/config";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
---

<BaseLayout lang={lang} title={t.pages.termsOfService.title} description={t.pages.termsOfService.description} path="/terms-of-service">
  <Container>
    <StaticPageBody copy={t.pages.termsOfService} lastUpdated={t.pages.termsOfService.lastUpdated} />
  </Container>
</BaseLayout>
