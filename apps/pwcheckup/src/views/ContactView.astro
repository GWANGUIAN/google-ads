---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@repo/ui/Container.astro";
import Button from "@repo/ui/Button.astro";
import { SITE } from "@/data/site";
import { getDictionary, type Locale } from "@/i18n/config";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
---

<BaseLayout lang={lang} title={t.pages.contact.title} description={t.pages.contact.description} path="/contact">
  <Container>
    <article class="mx-auto max-w-2xl py-14">
      <h1 class="text-3xl font-extrabold text-neutral-900">{t.pages.contact.title}</h1>
      <p class="mt-4 text-base leading-relaxed text-neutral-700">{t.pages.contact.body}</p>
      <Button href={`mailto:${SITE.contactEmail}`} class="mt-6">{t.pages.contact.buttonLabel}</Button>
    </article>
  </Container>
</BaseLayout>
