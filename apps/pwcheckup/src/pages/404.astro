---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@repo/ui/Container.astro";
import { getDictionary } from "@/i18n/config";

const t = getDictionary("ko");
---

<BaseLayout lang="ko" title={t.pages.notFound.title} description={t.pages.notFound.body} path="/404" noindex>
  <Container>
    <div class="mx-auto max-w-md py-24 text-center">
      <p class="text-6xl font-extrabold text-neutral-200">404</p>
      <h1 class="mt-4 text-2xl font-bold text-neutral-900">{t.pages.notFound.heading}</h1>
      <p class="mt-2 text-neutral-600">{t.pages.notFound.body}</p>
      <a href="/" class="mt-6 inline-block rounded-control bg-accent-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-accent-700">
        {t.pages.notFound.back}
      </a>
    </div>
  </Container>
</BaseLayout>
