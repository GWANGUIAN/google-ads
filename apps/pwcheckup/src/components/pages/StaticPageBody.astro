---
import type { StaticPageCopy } from "@/i18n/types";

interface Props {
  copy: StaticPageCopy;
  lastUpdated?: string;
}

const { copy, lastUpdated } = Astro.props;
---

<article class="mx-auto max-w-2xl py-14">
  <h1 class="text-3xl font-extrabold text-neutral-900">{copy.title}</h1>
  {lastUpdated && <p class="mt-2 text-sm text-neutral-500">{lastUpdated}</p>}

  <div class="mt-6 space-y-5 text-base leading-relaxed text-neutral-700">
    {
      copy.sections.map((section) => (
        <>
          <h2 class="text-xl font-bold text-neutral-900">{section.heading}</h2>
          {section.paragraphs.map((p) => <p>{p}</p>)}
        </>
      ))
    }
  </div>
</article>
