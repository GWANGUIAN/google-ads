# All PUBLIC_* vars are exposed to client-side code by Astro.
# Ads stay fully disabled (AdSlot renders nothing) until PUBLIC_ADS_ENABLED=true
# AND the relevant slot id below is set. See docs/NEW_SITE_PLAYBOOK.md.

PUBLIC_ADS_ENABLED=false
PUBLIC_ADSENSE_CLIENT_ID=
PUBLIC_AD_SLOT_HEADER=
PUBLIC_AD_SLOT_IN_CONTENT=
PUBLIC_AD_SLOT_FOOTER=

PUBLIC_SITE_URL=https://pwcheckup.com

# Search-engine ownership verification meta tags (optional, non-secret)
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_NAVER_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=

# Kakao Developers app JS key (Kakao SDK > 내 애플리케이션 > 앱 키 > JavaScript 키).
# Register pwcheckup.com under the app's "플랫폼 설정 > Web" first. This is a
# public/non-secret client value (same category as PUBLIC_ADSENSE_CLIENT_ID) —
# do NOT put it in GitHub Secrets. Share buttons render nothing without it.
PUBLIC_KAKAO_JS_KEY=
