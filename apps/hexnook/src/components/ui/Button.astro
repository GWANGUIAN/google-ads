---
// Local dark-theme reskin of @repo/ui/Button.astro (same prop API) — the
// shared primitive hardcodes light-theme colors (bg-white, text-neutral-900),
// and this is the first dark-only site in the repo, so a drop-in local
// variant is simpler than fighting Tailwind utility specificity to override it.
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost";
  class?: string;
  type?: "button" | "submit";
}

const { href, variant = "primary", class: className = "", type = "button" } = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-control px-5 py-2.5 text-sm font-semibold transition-all active:scale-95 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500 disabled:opacity-50 disabled:cursor-not-allowed";

const variants = {
  primary: "bg-accent-600 text-white hover:bg-accent-500 hover:shadow-[0_0_24px_-4px_var(--color-accent-500)]",
  secondary: "bg-neutral-800 text-neutral-100 border border-neutral-700 hover:border-neutral-600 hover:bg-neutral-700",
  ghost: "bg-transparent text-neutral-300 hover:bg-neutral-800/60 hover:text-white",
};

const classes = [base, variants[variant], className].join(" ");
---

{
  href ? (
    <a href={href} class={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes}>
      <slot />
    </button>
  )
}
