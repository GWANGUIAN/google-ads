---
import Container from "@repo/ui/Container.astro";
import { SITE } from "@/data/site";
import { TOOLS } from "@/data/tools";
---

<footer class="mt-16 border-t border-neutral-800 bg-neutral-950">
  <Container class="grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="text-base font-bold text-white">{SITE.name}</p>
      <p class="mt-2 text-sm text-neutral-400">{SITE.tagline}</p>
    </div>

    <div>
      <p class="text-sm font-semibold text-neutral-200">Tools</p>
      <ul class="mt-3 space-y-2 text-sm text-neutral-400">
        {
          TOOLS.map((tool) => (
            <li>
              <a href={tool.slug} class="hover:text-accent-400">
                {tool.shortLabel}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold text-neutral-200">Company</p>
      <ul class="mt-3 space-y-2 text-sm text-neutral-400">
        <li><a href="/about" class="hover:text-accent-400">About</a></li>
        <li><a href="/guides" class="hover:text-accent-400">Guides</a></li>
        <li><a href="/faq" class="hover:text-accent-400">FAQ</a></li>
        <li><a href="/contact" class="hover:text-accent-400">Contact</a></li>
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold text-neutral-200">Legal</p>
      <ul class="mt-3 space-y-2 text-sm text-neutral-400">
        <li><a href="/privacy-policy" class="hover:text-accent-400">Privacy Policy</a></li>
        <li><a href="/terms-of-service" class="hover:text-accent-400">Terms of Service</a></li>
      </ul>
    </div>
  </Container>

  <div class="border-t border-neutral-800 py-6">
    <Container>
      <p class="text-xs text-neutral-500">
        © {new Date().getFullYear()} {SITE.name}. Every tool runs locally in your browser — nothing you paste or upload is
        ever sent anywhere.
      </p>
    </Container>
  </div>
</footer>
