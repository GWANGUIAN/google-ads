---
import Card from "@/components/ui/Card.astro";
import type { ToolInfo } from "@/data/tools";

interface Props {
  tool: ToolInfo;
  class?: string;
}

const { tool, class: className = "" } = Astro.props;
---

<a href={tool.slug} class={`group block reveal ${className}`}>
  <Card hover class="h-full">
    <span
      class="flex h-11 w-11 items-center justify-center rounded-control bg-accent-600/15 font-mono text-sm font-bold text-accent-400 transition-colors group-hover:bg-accent-600/25"
    >
      {tool.glyph}
    </span>
    <p class="mt-4 text-base font-bold text-white">{tool.name}</p>
    <p class="mt-1.5 text-sm text-neutral-400">{tool.tagline}</p>
    <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-accent-400">
      Open tool
      <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
    </span>
  </Card>
</a>
