---
interface Props {
  title: string;
  subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<section class="relative overflow-hidden py-10 sm:py-14">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute left-1/2 top-[-30%] h-[320px] w-[560px] -translate-x-1/2 rounded-full opacity-15 blur-[100px]"
      style="background: radial-gradient(closest-side, var(--color-accent-600), transparent)"
    >
    </div>
  </div>

  <div class="mx-auto max-w-3xl text-center">
    <h1 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">{title}</h1>
    <p class="mx-auto mt-3 max-w-xl text-base text-neutral-400">{subtitle}</p>
  </div>

  <div class="mx-auto mt-8 max-w-3xl">
    <slot />
  </div>
</section>
