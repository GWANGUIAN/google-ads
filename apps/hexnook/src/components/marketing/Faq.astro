---
import Accordion from "@/components/ui/Accordion";
import type { FaqItem } from "@/data/toolFaq";

interface Props {
  items: FaqItem[];
  heading?: string;
}

const { items, heading = "Frequently asked questions" } = Astro.props;
---

<div>
  <h2 class="text-xl font-bold text-white">{heading}</h2>
  <div class="mt-4">
    <Accordion client:visible items={items} />
  </div>
</div>
