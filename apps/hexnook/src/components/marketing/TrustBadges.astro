---
const badges = [
  { title: "100% client-side", desc: "Nothing you paste is ever uploaded" },
  { title: "No sign-up", desc: "Every tool works instantly" },
  { title: "Unlimited & free", desc: "No limits, no watermarks" },
  { title: "Open source engines", desc: "Web Crypto, native RegExp, JSON.parse" },
];
---

<div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
  {
    badges.map((badge) => (
      <div class="rounded-card border border-neutral-800 bg-neutral-900/60 px-4 py-3 text-center">
        <p class="text-sm font-semibold text-white">{badge.title}</p>
        <p class="mt-0.5 text-xs text-neutral-500">{badge.desc}</p>
      </div>
    ))
  }
</div>
