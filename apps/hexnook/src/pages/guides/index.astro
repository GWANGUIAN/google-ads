---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@repo/ui/Container.astro";
import { GUIDES } from "@/data/guides";
import { SITE } from "@/data/site";
---

<BaseLayout
  title={`Guides | ${SITE.name}`}
  description="Plain-English explainers on JSON, Base64, hashing, regex, and JWTs — the concepts behind hexnook's tools."
  path="/guides"
>
  <Container>
    <div class="mx-auto max-w-2xl py-14">
      <h1 class="text-3xl font-extrabold text-white">Guides</h1>
      <p class="mt-3 text-base text-neutral-400">Plain-English explainers on the concepts behind each tool.</p>

      <div class="mt-8 space-y-4">
        {
          GUIDES.map((guide) => (
            <a
              href={guide.slug}
              class="block rounded-card border border-neutral-800 bg-neutral-900 p-5 transition-all hover:-translate-y-0.5 hover:border-accent-600/50"
            >
              <p class="text-base font-bold text-white">{guide.title}</p>
              <p class="mt-1.5 text-sm text-neutral-400">{guide.excerpt}</p>
            </a>
          ))
        }
      </div>
    </div>
  </Container>
</BaseLayout>
