---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@repo/ui/Container.astro";
import { SITE } from "@/data/site";
---

<BaseLayout title={`Page not found | ${SITE.name}`} description="This page doesn't exist." path="/404" noindex>
  <Container>
    <div class="mx-auto max-w-md py-24 text-center">
      <p class="font-mono text-6xl font-extrabold text-neutral-800">404</p>
      <h1 class="mt-4 text-2xl font-bold text-white">Page not found</h1>
      <p class="mt-2 text-neutral-400">The page you're looking for doesn't exist or has moved.</p>
      <a
        href="/"
        class="mt-6 inline-block rounded-control bg-accent-600 px-5 py-2.5 text-sm font-semibold text-white transition-all hover:bg-accent-500 active:scale-95"
      >
        Go back home
      </a>
    </div>
  </Container>
</BaseLayout>
