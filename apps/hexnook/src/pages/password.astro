---
import ToolPageLayout from "@/layouts/ToolPageLayout.astro";
import PasswordTool from "@/components/tools/PasswordTool";
import { passwordFaq } from "@/data/toolFaq";
---

<ToolPageLayout
  title="Password Generator — Strong, Random, Free | hexnook"
  description="Generate strong, random passwords with customizable length and character sets, using your browser's cryptographically secure random number generator."
  path="/password"
  heroTitle="Password Generator"
  heroSubtitle="Generate strong, random passwords — never transmitted, logged, or stored anywhere."
  breadcrumbName="Password Generator"
  faqItems={passwordFaq}
>
  <PasswordTool client:idle />
</ToolPageLayout>
