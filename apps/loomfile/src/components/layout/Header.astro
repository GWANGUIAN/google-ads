---
import Container from "@repo/ui/Container.astro";
import { SITE, TOOLS } from "@/data/site";
---

<header class="border-b border-neutral-200 bg-white/80 backdrop-blur">
  <Container class="flex h-16 items-center justify-between">
    <a href="/" class="flex items-center gap-2 text-base font-bold text-neutral-900">
      <span class="flex h-8 w-8 items-center justify-center rounded-control bg-accent-600 text-white">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 7h16M4 12h16M4 17h10" stroke-linecap="round" />
        </svg>
      </span>
      {SITE.name}
    </a>
    <nav class="hidden items-center gap-5 text-sm font-medium text-neutral-600 lg:flex">
      {TOOLS.map((tool) => (
        <a
          href={tool.slug}
          target={tool.external ? "_blank" : undefined}
          rel={tool.external ? "noopener noreferrer" : undefined}
          class="hover:text-neutral-900"
        >
          {tool.name}
        </a>
      ))}
    </nav>
  </Container>
</header>
