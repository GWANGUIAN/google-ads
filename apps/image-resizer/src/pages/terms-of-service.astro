---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@repo/ui/Container.astro";
import { SITE } from "@/data/site";
import { withBase } from "@repo/file-tools-core/url.ts";

const lastUpdated = "September 5, 2026";
---

<BaseLayout title={`Terms of Service | ${SITE.name}`} description={`The terms governing your use of ${SITE.name}.`} path="/terms-of-service">
  <Container>
    <article class="mx-auto max-w-2xl py-14">
      <h1 class="text-3xl font-extrabold text-neutral-900">Terms of Service</h1>
      <p class="mt-2 text-sm text-neutral-500">Last updated: {lastUpdated}</p>

      <div class="mt-6 space-y-5 text-base leading-relaxed text-neutral-700">
        <h2 class="text-xl font-bold text-neutral-900">Acceptance of terms</h2>
        <p>By using {SITE.name}, you agree to these Terms of Service. If you don't agree, please don't use the site.</p>

        <h2 class="text-xl font-bold text-neutral-900">Use of the service</h2>
        <p>
          {SITE.name} provides free, client-side image resizing. You may use it for personal or commercial purposes,
          subject to these terms. You are solely responsible for the images you resize and distribute, including
          ensuring you have the right to use and share their content.
        </p>

        <h2 class="text-xl font-bold text-neutral-900">No warranty</h2>
        <p>
          This service is provided "as is," without warranty of any kind, express or implied. We do not guarantee
          that a resized image will meet any particular platform's or agency's exact requirements (see, for example,
          the passport photo caveat on that preset's page), or that a result will be preserved if your browser tab
          closes before you download it.
        </p>

        <h2 class="text-xl font-bold text-neutral-900">Limitation of liability</h2>
        <p>
          To the fullest extent permitted by law, {SITE.name} and its operators shall not be liable for any
          indirect, incidental, or consequential damages arising from your use of this service, including from a
          resized image that is rejected by a third party for not meeting its own requirements.
        </p>

        <h2 class="text-xl font-bold text-neutral-900">Acceptable use</h2>
        <p>
          You agree not to use this service to process images that are illegal, infringe on others' rights, or
          violate applicable law.
        </p>

        <h2 class="text-xl font-bold text-neutral-900">Changes</h2>
        <p>We may update these terms from time to time. Continued use of the site after changes constitutes acceptance of the updated terms.</p>

        <h2 class="text-xl font-bold text-neutral-900">Contact</h2>
        <p>Questions about these terms? See our <a href={withBase("/contact")} class="text-accent-600 underline">Contact page</a>.</p>
      </div>
    </article>
  </Container>
</BaseLayout>
