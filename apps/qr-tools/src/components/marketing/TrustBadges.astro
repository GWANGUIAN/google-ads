---
const badges = [
  { title: "100% private", desc: "Nothing you enter is uploaded" },
  { title: "No sign-up", desc: "Just fill in the details and go" },
  { title: "Unlimited & free", desc: "No limits, no watermarks" },
  { title: "PNG & SVG", desc: "Download in either format" },
];
---

<div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
  {
    badges.map((badge) => (
      <div class="rounded-card border border-neutral-200 bg-white px-4 py-3 text-center">
        <p class="text-sm font-semibold text-neutral-900">{badge.title}</p>
        <p class="mt-0.5 text-xs text-neutral-500">{badge.desc}</p>
      </div>
    ))
  }
</div>
