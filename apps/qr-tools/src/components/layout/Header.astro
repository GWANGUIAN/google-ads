---
import Container from "@repo/ui/Container.astro";
import { SITE } from "@/data/site";
import { withBase } from "@repo/file-tools-core/url.ts";
---

<header class="border-b border-neutral-200 bg-white/80 backdrop-blur">
  <Container class="flex h-16 items-center justify-between">
    <a href={withBase("/")} class="flex items-center gap-2 text-base font-bold text-neutral-900">
      <span class="flex h-8 w-8 items-center justify-center rounded-control bg-accent-600 text-white">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="7" height="7" rx="1" />
          <rect x="14" y="3" width="7" height="7" rx="1" />
          <rect x="3" y="14" width="7" height="7" rx="1" />
          <path d="M14 14h3v3h-3zM19 14h2v2h-2zM14 19h2v2h-2zM19 19h2v2h-2z" fill="currentColor" stroke="none" />
        </svg>
      </span>
      {SITE.name}
    </a>
    <nav class="hidden items-center gap-5 text-sm font-medium text-neutral-600 lg:flex">
      <a href={withBase("/")} class="hover:text-neutral-900">Generate</a>
      <a href={withBase("/scan")} class="hover:text-neutral-900">Scan</a>
      <a href={withBase("/batch")} class="hover:text-neutral-900">Batch</a>
      <a href={withBase("/faq")} class="hover:text-neutral-900">FAQ</a>
      <a href={withBase("/how-it-works")} class="hover:text-neutral-900">How it works</a>
    </nav>
  </Container>
</header>
