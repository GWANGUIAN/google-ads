---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@repo/ui/Container.astro";
import JsonLd from "@repo/seo/JsonLd.astro";
import { softwareApplicationSchema, breadcrumbListSchema } from "@repo/seo/schema";
import AdSlot from "@/components/ads/AdSlot.astro";
import BatchQrWidget from "@/components/qr/BatchQrWidget";
import { SITE } from "@/data/site";
import { withBase } from "@/lib/url";

const canonical = new URL(withBase("/batch"), SITE.url).toString();
const homeUrl = new URL(withBase("/"), SITE.url).toString();
---

<BaseLayout
  title={`Batch QR Code Generator — Generate Many at Once Free | ${SITE.name}`}
  description="Paste a list of URLs or text and generate a QR code for each one, then download them all as a ZIP — free, private, in your browser."
  path="/batch"
>
  <JsonLd schema={softwareApplicationSchema({ name: "Batch QR Code Generator", url: canonical, description: "Generate many QR codes at once from a list, and download them as a ZIP.", applicationCategory: "BusinessApplication" })} />
  <JsonLd schema={breadcrumbListSchema([{ name: "Home", url: homeUrl }, { name: "Batch", url: canonical }])} />

  <Container>
    <section class="py-12 text-center sm:py-16">
      <h1 class="mx-auto max-w-3xl text-3xl font-extrabold tracking-tight text-neutral-900 sm:text-4xl">
        Batch generate QR codes
      </h1>
      <p class="mx-auto mt-4 max-w-xl text-base text-neutral-600">
        Paste up to 200 lines — one URL or piece of text per line — and get a QR code for each, downloadable
        individually or all together as a ZIP.
      </p>
    </section>

    <section class="mx-auto max-w-3xl py-6">
      <BatchQrWidget client:idle />
    </section>

    <AdSlot position="in-content" class="py-4" />
  </Container>
</BaseLayout>
