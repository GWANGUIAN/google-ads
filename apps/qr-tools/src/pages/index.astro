---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@repo/ui/Container.astro";
import TrustBadges from "@/components/marketing/TrustBadges.astro";
import AdSlot from "@/components/ads/AdSlot.astro";
import QrGeneratorWidget from "@/components/qr/QrGeneratorWidget";
import { QR_TYPE_LIST } from "@/data/qrTypes";
import { SITE } from "@/data/site";
import { withBase } from "@/lib/url";
---

<BaseLayout title={`${SITE.name} — Generate & Scan QR Codes Free`} description={SITE.description} path="/">
  <Container>
    <section class="py-12 text-center sm:py-16">
      <h1 class="mx-auto max-w-3xl text-3xl font-extrabold tracking-tight text-neutral-900 sm:text-4xl">
        Generate a QR code, right in your browser
      </h1>
      <p class="mx-auto mt-4 max-w-xl text-base text-neutral-600">
        No uploads, no sign-up, no limits. URLs, WiFi, contact cards, and more — customize the color, add a logo,
        download PNG or SVG.
      </p>
      <div class="mx-auto mt-8 max-w-2xl">
        <TrustBadges />
      </div>
    </section>

    <section class="mx-auto max-w-2xl py-6">
      <QrGeneratorWidget client:idle initialType="url" />
    </section>

    <AdSlot position="in-content" class="py-4" />

    <section class="py-10">
      <h2 class="text-xl font-bold text-neutral-900">QR code types</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          QR_TYPE_LIST.map((type) => (
            <a href={withBase(type.slug)} class="rounded-card border border-neutral-200 bg-white p-5 hover:border-accent-400 hover:shadow-sm">
              <p class="text-base font-bold text-neutral-900">{type.label} QR code</p>
              <p class="mt-1.5 text-sm text-neutral-600">{type.description}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="grid gap-4 pb-10 sm:grid-cols-2">
      <a href={withBase("/scan")} class="rounded-card border border-neutral-200 bg-white p-6 hover:border-accent-400 hover:shadow-sm">
        <p class="text-base font-bold text-neutral-900">Scan a QR code →</p>
        <p class="mt-1.5 text-sm text-neutral-600">Upload an image or use your camera to decode any QR code, instantly and privately.</p>
      </a>
      <a href={withBase("/batch")} class="rounded-card border border-neutral-200 bg-white p-6 hover:border-accent-400 hover:shadow-sm">
        <p class="text-base font-bold text-neutral-900">Batch generate →</p>
        <p class="mt-1.5 text-sm text-neutral-600">Paste a list of URLs or text, generate dozens of QR codes at once, download them all as a ZIP.</p>
      </a>
    </section>
  </Container>
</BaseLayout>
