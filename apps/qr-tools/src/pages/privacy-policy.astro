---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@repo/ui/Container.astro";
import { SITE } from "@/data/site";
import { withBase } from "@/lib/url";

const lastUpdated = "September 4, 2026";
---

<BaseLayout
  title={`Privacy Policy | ${SITE.name}`}
  description={`How ${SITE.name} handles your data. In short: nothing you enter or scan ever leaves your browser.`}
  path="/privacy-policy"
>
  <Container>
    <article class="mx-auto max-w-2xl py-14">
      <h1 class="text-3xl font-extrabold text-neutral-900">Privacy Policy</h1>
      <p class="mt-2 text-sm text-neutral-500">Last updated: {lastUpdated}</p>

      <div class="mt-6 space-y-5 text-base leading-relaxed text-neutral-700">
        <h2 class="text-xl font-bold text-neutral-900">What you generate or scan</h2>
        <p>
          {SITE.name} builds and reads QR codes entirely within your browser using open-source JavaScript libraries.
          Any text you type into the generator — a URL, a WiFi password, a contact's details — is used only to draw
          the code on your screen and is never transmitted anywhere. See{" "}
          <a href={withBase("/how-it-works")} class="text-accent-600 underline">How it works</a> for how to verify
          this yourself using your browser's developer tools.
        </p>

        <h2 class="text-xl font-bold text-neutral-900">Logo images</h2>
        <p>
          If you upload an image to place as a logo on a generated code, that image is read directly into your
          browser's memory and drawn onto the code locally — it is never uploaded to any server we operate.
        </p>

        <h2 class="text-xl font-bold text-neutral-900">Camera access</h2>
        <p>
          The QR scanner can optionally use your device's camera to scan codes live. Camera access is requested by
          your browser directly, using the standard permission prompt, and video frames are processed locally to
          look for a QR code — no video or image data is ever sent to us or stored anywhere. You can deny or revoke
          camera access at any time in your browser settings, and the tool still works by uploading an image
          instead.
        </p>

        <h2 class="text-xl font-bold text-neutral-900">Analytics</h2>
        <p>
          We may use privacy-respecting analytics to understand aggregate traffic patterns (e.g. which pages are
          visited, approximate country of origin). This data is anonymized/aggregated and is not linked to any
          content you generate or scan on this site.
        </p>

        <h2 class="text-xl font-bold text-neutral-900">Advertising</h2>
        <p>
          This site may display advertising served by Google AdSense. Google and its partners may use cookies or
          similar technologies to serve ads based on your prior visits to this or other websites. You can opt out of
          personalized advertising by visiting Google's
          <a href="https://adssettings.google.com" class="text-accent-600 underline" rel="noopener noreferrer" target="_blank">
            Ads Settings
          </a>. For more information on how Google uses data, see
          <a
            href="https://policies.google.com/technologies/partner-sites"
            class="text-accent-600 underline"
            rel="noopener noreferrer"
            target="_blank"
          >
            How Google uses information from sites that use its services
          </a>.
        </p>

        <h2 class="text-xl font-bold text-neutral-900">Cookies</h2>
        <p>
          This site itself does not set cookies for its QR tools to function. Third-party services we use
          (analytics, advertising, once enabled) may set their own cookies, governed by their own privacy policies.
        </p>

        <h2 class="text-xl font-bold text-neutral-900">Your rights</h2>
        <p>
          Depending on your location, you may have rights under regulations such as the GDPR or CCPA to access,
          correct, or delete personal data we hold about you. Since we do not collect the content you generate or
          scan, there is generally nothing of that nature to request. For questions, see our{" "}
          <a href={withBase("/contact")} class="text-accent-600 underline">Contact page</a>.
        </p>

        <h2 class="text-xl font-bold text-neutral-900">Changes to this policy</h2>
        <p>We may update this policy from time to time. Changes will be posted on this page with an updated revision date.</p>
      </div>
    </article>
  </Container>
</BaseLayout>
