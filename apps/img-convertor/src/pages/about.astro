---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@repo/ui/Container.astro";
import { SITE } from "@/data/site";
import { withBase } from "@/lib/url";
---

<BaseLayout
  title={`About ${SITE.name}`}
  description={`Learn how ${SITE.name} works, why it's free, and why your images never leave your device.`}
  path="/about"
>
  <Container>
    <article class="mx-auto max-w-2xl py-14">
      <h1 class="text-3xl font-extrabold text-neutral-900">About {SITE.name}</h1>

      <div class="mt-6 space-y-5 text-base leading-relaxed text-neutral-700">
        <p>
          {SITE.name} is a free tool for converting images between common formats — PNG, JPG, WEBP, BMP,
          GIF, and HEIC — directly in your web browser. There's no sign-up, no watermark, and no limit on
          how many images you can convert.
        </p>

        <h2 class="text-xl font-bold text-neutral-900">Why is it free?</h2>
        <p>
          Image conversion is a simple, solved problem — your browser already has everything needed to
          decode and re-encode images. We built {SITE.name} to make that capability easy to use, without
          asking you to install software or upload your files to a stranger's server.
        </p>

        <h2 class="text-xl font-bold text-neutral-900">Your images never leave your device</h2>
        <p>
          Every conversion on this site happens locally, using your browser's built-in Canvas API. Your
          files are read, converted, and downloaded entirely on your own computer or phone — at no point
          are they uploaded to any server. We can't see your images, because we never receive them.
        </p>

        <h2 class="text-xl font-bold text-neutral-900">Who's behind this</h2>
        <p>
          {SITE.name} is an independent, small-scale project focused on doing one thing well: fast, private
          image conversion. It's also part of the <a href="https://loomfile.com" class="text-accent-600 underline">LoomFile</a>{" "}
          family of free, private, in-browser file tools. If you have feedback or run into a bug, see our{" "}
          <a href={withBase("/contact")} class="text-accent-600 underline">Contact page</a>.
        </p>
      </div>
    </article>
  </Container>
</BaseLayout>
