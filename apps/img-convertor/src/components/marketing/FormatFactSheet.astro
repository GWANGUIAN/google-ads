---
import type { FormatInfo } from "@/data/formats";

interface Props {
  format: FormatInfo;
}

const { format } = Astro.props;
---

<div class="rounded-card border border-neutral-200 bg-white p-5">
  <div class="flex items-center justify-between">
    <h3 class="text-lg font-bold text-neutral-900">{format.label}</h3>
    <span class="rounded-full bg-neutral-100 px-2.5 py-0.5 text-xs font-medium capitalize text-neutral-600">
      {format.compression} compression
    </span>
  </div>

  <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-xs text-neutral-500">
    <div>
      <dt class="font-medium text-neutral-700">Transparency</dt>
      <dd>{format.supportsTransparency ? "Supported" : "Not supported"}</dd>
    </div>
    <div>
      <dt class="font-medium text-neutral-700">Animation</dt>
      <dd>{format.supportsAnimation ? "Supported" : "Not supported"}</dd>
    </div>
  </dl>

  <div class="mt-4">
    <p class="text-xs font-semibold uppercase tracking-wide text-neutral-400">Typically used for</p>
    <p class="mt-1 text-sm text-neutral-600">{format.typicalUse.join(", ")}</p>
  </div>

  <div class="mt-4 grid gap-3 sm:grid-cols-2">
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-success-500">Pros</p>
      <ul class="mt-1 space-y-1 text-sm text-neutral-600">
        {format.pros.map((pro) => <li>+ {pro}</li>)}
      </ul>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-danger-500">Cons</p>
      <ul class="mt-1 space-y-1 text-sm text-neutral-600">
        {format.cons.map((con) => <li>- {con}</li>)}
      </ul>
    </div>
  </div>
</div>
